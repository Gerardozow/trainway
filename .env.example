VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ALLOWED_ORIGINS no se lee de aquí: es un secreto de la Edge Function
# sign-in (`pnpm supabase secrets set ALLOWED_ORIGINS=...`), no una variable
# de Vite. Se documenta aquí para que quien despliegue sepa que existe y no
# se le olvide -- ver README.md, sección "Despliegue de la Edge Function".
# Sin fijarla, el primer despliegue real sirve el origen de desarrollo
# (localhost) y el navegador descarta la respuesta por CORS.
# ALLOWED_ORIGINS=https://tu-dominio.com,https://otro-dominio.com
